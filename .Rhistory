library(tidyverse)
music <- read.csv("~/Desktop/data.sets/tcc_ceds_music.csv")
social_unrest <- read.csv("~/Desktop/data.sets/39411.csv")
positive_topics <- c("music", "romantic")
negative_topics <- c("violence", "sadness")
neutral_topics  <- c("feelings", "night/time", "world/life", "obscene")
music_topic <- music %>%
mutate(
theme_group = case_when(
topic %in% positive_topics ~ "Positive",
topic %in% negative_topics ~ "Negative",
topic %in% neutral_topics  ~ "Both/Neutral",
)
)
social_unrest_USA <- social_unrest %>%
filter(Country == "United States")
# Prepare social unrest data
social_unrest_by_year <- social_unrest_USA %>%
mutate(year = as.numeric(format(as.Date(Date), "%Y"))) %>%
group_by(year) %>%
summarise(avg_unrest = mean(Social.Unrest.Index, na.rm = TRUE))
# Prepare negative music data
music_negative <- music_topic %>%
filter(theme_group == "Negative") %>%
mutate(year = as.numeric(substr(release_date, 1, 4))) %>%  # Extract year from release_date
group_by(year) %>%
summarise(negative_count = n())
# Join datasets
combined_data <- music_negative %>%
inner_join(social_unrest_by_year, by = "year")
# Create line graph
ggplot(combined_data, aes(x = year)) +
geom_line(aes(y = negative_count, color = "Negative Music Topics"), linewidth = 1) +
geom_line(aes(y = avg_unrest * (max(negative_count) / max(avg_unrest)),
color = "Social Unrest Index"), linewidth = 1) +
scale_y_continuous(
name = "Count of Negative Music Topics",
sec.axis = sec_axis(~ . * max(combined_data$avg_unrest) / max(combined_data$negative_count),
name = "Social Unrest Index")
) +
scale_color_manual(values = c("Negative Music Topics" = "#E74C3C",
"Social Unrest Index" = "#3498DB")) +
labs(
title = "Negative Music Topics vs Social Unrest Over Time",
x = "Year",
color = ""
) +
theme_minimal()
library(tidyverse)
music <- read.csv("~/Desktop/data.sets/tcc_ceds_music.csv")
social_unrest <- read.csv("~/Desktop/data.sets/39411.csv")
positive_topics <- c("music", "romantic")
negative_topics <- c("violence", "sadness")
neutral_topics  <- c("feelings", "night/time", "world/life", "obscene")
music_topic <- music %>%
mutate(
theme_group = case_when(
topic %in% positive_topics ~ "Positive",
topic %in% negative_topics ~ "Negative",
topic %in% neutral_topics  ~ "Both/Neutral",
)
)
social_unrest_USA <- social_unrest %>%
filter(Country == "United States")
# Prepare social unrest data
social_unrest_by_year <- social_unrest_USA %>%
mutate(year = as.numeric(format(as.Date(Date), "%Y"))) %>%
group_by(year) %>%
summarise(avg_unrest = mean(Social.Unrest.Index, na.rm = TRUE))
# Prepare negative music data
music_negative <- music_topic %>%
filter(theme_group == "Negative") %>%
mutate(year = as.numeric(substr(release_date, 1, 4))) %>%  # Extract year from release_date
group_by(year) %>%
summarise(negative_count = n())
# Join datasets
combined_data <- music_negative %>%
inner_join(social_unrest_by_year, by = "year")
# Create line graph
ggplot(combined_data, aes(x = year)) +
geom_line(aes(y = negative_count, color = "Negative Music Topics"), linewidth = 1) +
geom_line(aes(y = avg_unrest * (max(negative_count) / max(avg_unrest)),
color = "Social Unrest Index"), linewidth = 1) +
scale_y_continuous(
name = "Count of Negative Music Topics",
sec.axis = sec_axis(~ . * max(combined_data$avg_unrest) / max(combined_data$negative_count),
name = "Social Unrest Index")
) +
scale_color_manual(values = c("Negative Music Topics" = "#E74C3C",
"Social Unrest Index" = "#3498DB")) +
labs(
title = "Negative Music Topics vs Social Unrest Over Time",
x = "Year",
color = ""
) +
theme_minimal() +
theme(
plot.title = element_text(size = 18, face = "bold"),    # Title size
axis.title = element_text(size = 14),                    # Both axis labels
axis.text = element_text(size = 12),                     # Axis tick labels
legend.text = element_text(size = 12),                   # Legend text
legend.title = element_text(size = 14)                   # Legend title
)
